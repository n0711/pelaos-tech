diff --git a/frontend/src/utils/placeNames.js b/frontend/src/utils/placeNames.js
new file mode 100644
--- /dev/null
+++ b/frontend/src/utils/placeNames.js
@@ -0,0 +1,112 @@
+import catalog from "../data/placeNames.json";
+
+export const CLAIM_STATUS_LABELS = {
+    reported: "Source-reported",
+    proposed: "Possible explanation",
+    disputed: "Disputed explanation",
+    unresolved: "Origin not yet added",
+};
+
+export function normalizePlaceText(value) {
+    return String(value ?? "").normalize("NFD")
+        .replace(/[\u0300-\u036f]/g, "").toLowerCase()
+        .replace(/ς/g, "σ").replace(/ı/g, "i").trim();
+}
+
+export function isSourceUrl(value) {
+    // Public documentary links must be absolute HTTPS URLs, without credentials,
+    // whitespace or backslashes. No network lookup is performed by the app.
+    return typeof value === "string" &&
+        /^https:\/\/(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,63}(?::[0-9]{1,5})?(?:[/?#][^\s\\]*)?$/i.test(value);
+}
+
+const nonempty = (value) => typeof value === "string" && Boolean(value.trim());
+const numberInRange = (value, min, max) =>
+    typeof value === "number" && Number.isFinite(value) && value >= min && value <= max;
+
+// Invalid or unpublished records are never presented as public evidence.
+export function validatePlace(place) {
+    if (!place || typeof place !== "object") return false;
+    if (!nonempty(place.id) || !nonempty(place.displayName)) return false;
+    if (!["published", "draft"].includes(place.editorialStatus)) return false;
+    if (!numberInRange(place.latitude, -90, 90) ||
+        !numberInRange(place.longitude, -180, 180)) return false;
+    if (!Array.isArray(place.aliases) || !Array.isArray(place.claims) ||
+        !Array.isArray(place.sources) || !place.sources.length) return false;
+    if (place.sources.some((source) => !source || !nonempty(source.id) ||
+        !nonempty(source.title) || !nonempty(source.publisher) ||
+        !isSourceUrl(source.url) || (source.coordinateEvidenceUrl && !isSourceUrl(source.coordinateEvidenceUrl)) ||
+        !/^\d{4}-\d{2}-\d{2}$/.test(source.accessedOn))) return false;
+    const sourceIds = new Set(place.sources.map((source) => source.id));
+    if (sourceIds.size !== place.sources.length || !sourceIds.has(place.locationSourceId)) return false;
+    if (place.aliases.some((alias) => !alias || !nonempty(alias.name) ||
+        !["current", "historical", "variant"].includes(alias.kind) ||
+        !sourceIds.has(alias.sourceId))) return false;
+    const claimIds = new Set();
+    return place.claims.every((claim) => {
+        if (!claim || !nonempty(claim.id) || claimIds.has(claim.id)) return false;
+        claimIds.add(claim.id);
+        return ["name-history", "etymology"].includes(claim.kind) &&
+            ["reported", "proposed", "disputed"].includes(claim.status) &&
+            nonempty(claim.summary) && Array.isArray(claim.sourceIds) &&
+            claim.sourceIds.length > 0 && claim.sourceIds.every((id) => sourceIds.has(id));
+    });
+}
+
+export function publishedPlaces(records) {
+    if (!Array.isArray(records)) return [];
+    const seen = new Set();
+    return records.filter((place) => {
+        if (!validatePlace(place) || place.editorialStatus !== "published" || seen.has(place.id)) return false;
+        seen.add(place.id);
+        return true;
+    });
+}
+
+export const PLACE_NAMES = catalog.schemaVersion === 1 ? publishedPlaces(catalog.places) : [];
+
+export function getOriginStatus(place) {
+    const claims = place.claims.filter((claim) => claim.kind === "etymology");
+    if (!claims.length) return "unresolved";
+    if (claims.some((claim) => claim.status === "disputed")) return "disputed";
+    if (claims.some((claim) => claim.status === "proposed")) return "proposed";
+    return "reported";
+}
+
+export function filterPlaceNames(places, query = "", status = "all") {
+    const term = normalizePlaceText(query);
+    return places.filter((place) => {
+        if (status !== "all" && getOriginStatus(place) !== status) return false;
+        const text = [place.displayName, ...place.aliases.map((alias) => alias.name),
+            ...place.claims.map((claim) => claim.summary)].join(" ");
+        return !term || normalizePlaceText(text).includes(term);
+    });
+}
+
+function coordinate(value, min, max) {
+    if (typeof value !== "number" &&
+        (typeof value !== "string" || !value.trim())) return null;
+    const result = Number(value);
+    return Number.isFinite(result) && result >= min && result <= max ? result : null;
+}
+
+function distanceKm(lat1, lon1, lat2, lon2) {
+    const radians = (degrees) => degrees * Math.PI / 180;
+    const dLat = radians(lat2 - lat1);
+    const dLon = radians(lon2 - lon1);
+    const a = Math.sin(dLat / 2) ** 2 + Math.cos(radians(lat1)) *
+        Math.cos(radians(lat2)) * Math.sin(dLon / 2) ** 2;
+    return 6371 * 2 * Math.asin(Math.sqrt(Math.min(1, a)));
+}
+
+// Geographic proximity is a browsing aid, never an asserted historical link.
+export function nearbyApprovedStories(place, stories) {
+    return stories.filter((story) => story.status === "approved").map((story) => {
+        const latitude = coordinate(story.latitude, -90, 90);
+        const longitude = coordinate(story.longitude, -180, 180);
+        if (latitude === null || longitude === null) return null;
+        return { story, distanceKm: distanceKm(place.latitude, place.longitude, latitude, longitude) };
+    }).filter((match) => match && match.distanceKm <= 2)
+        .sort((a, b) => a.distanceKm - b.distanceKm || a.story.id - b.story.id)
+        .slice(0, 3);
+}
diff --git a/frontend/src/components/PlaceNameCard.js b/frontend/src/components/PlaceNameCard.js
new file mode 100644
--- /dev/null
+++ b/frontend/src/components/PlaceNameCard.js
@@ -0,0 +1,93 @@
+import { Link } from "react-router-dom";
+import { CLAIM_STATUS_LABELS, nearbyApprovedStories } from "../utils/placeNames";
+
+function SourceLink({ source }) {
+    return <a href={source.url} target="_blank" rel="noopener noreferrer">{source.publisher}</a>;
+}
+
+function Claim({ claim, sources }) {
+    return (
+        <li className="place-name-claim">
+            <span className={`place-name-status place-name-status-${claim.status}`}>
+                {CLAIM_STATUS_LABELS[claim.status]}
+            </span>
+            <p>{claim.summary}</p>
+            <span className="place-name-citation">
+                Source: {claim.sourceIds.map((id, index) => (
+                    <span key={id}>{index > 0 && "; "}<SourceLink source={sources.find((source) => source.id === id)} /></span>
+                ))}
+            </span>
+        </li>
+    );
+}
+
+export default function PlaceNameCard({ place, stories = [], storiesLoading = false, storiesError = "" }) {
+    const origins = place.claims.filter((claim) => claim.kind === "etymology");
+    const history = place.claims.filter((claim) => claim.kind === "name-history");
+    const nearby = nearbyApprovedStories(place, stories);
+    const locationSource = place.sources.find((source) => source.id === place.locationSourceId);
+
+    return (
+        <article className="place-name-card" aria-label={`Place-name record: ${place.displayName}`}>
+            <span className="place-name-eyebrow">OpenPELAOS · Place names</span>
+            <h3>{place.displayName}</h3>
+            <ul className="place-name-aliases" aria-label="Names in this record">
+                {place.aliases.map((alias) => (
+                    <li key={alias.name}>
+                        <span lang={alias.language}>{alias.name}</span> <small>({alias.kind})</small>{" "}
+                        <a href={place.sources.find((source) => source.id === alias.sourceId).url}
+                            target="_blank" rel="noopener noreferrer" aria-label={`Source for ${alias.name}`}>source</a>
+                    </li>
+                ))}
+            </ul>
+            {history.length > 0 && (
+                <section>
+                    <h4>Name history</h4>
+                    <ul className="place-name-claims">
+                        {history.map((claim) => <Claim key={claim.id} claim={claim} sources={place.sources} />)}
+                    </ul>
+                </section>
+            )}
+            <section>
+                <h4>The story behind the name</h4>
+                {origins.length ? (
+                    <ul className="place-name-claims">
+                        {origins.map((claim) => <Claim key={claim.id} claim={claim} sources={place.sources} />)}
+                    </ul>
+                ) : <p>No origin explanation has been added to this record.</p>}
+            </section>
+            <details className="place-name-sources">
+                <summary>Sources and map location</summary>
+                <p>Approximate settlement point from <SourceLink source={locationSource} />; not a historical boundary.</p>
+                <ul>
+                    {place.sources.map((source) => (
+                        <li key={source.id}>
+                            <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
+                            <small>{source.publisher} · Accessed {source.accessedOn}</small>
+                            {source.coordinateEvidenceUrl && (
+                                <a href={source.coordinateEvidenceUrl} target="_blank" rel="noopener noreferrer">Coordinate record</a>
+                            )}
+                        </li>
+                    ))}
+                </ul>
+                <p>Coordinates and selected name variants: <a href="https://www.geonames.org/export/"
+                    target="_blank" rel="noopener noreferrer">GeoNames (CC BY)</a>.</p>
+            </details>
+            <section className="place-name-nearby">
+                <h4>Nearby community stories</h4>
+                <p>Within 2 km of the map point, in the selected story category. Proximity does not establish a historical connection.</p>
+                {storiesLoading ? <p role="status">Loading nearby stories…</p> : storiesError ? (
+                    <p>Nearby stories are temporarily unavailable.</p>
+                ) : nearby.length ? (
+                    <ul>{nearby.map(({ story, distanceKm }) => (
+                        <li key={story.id}>
+                            <Link to={`/story/${story.id}`}>{story.title}</Link>
+                            <small>Approximately {distanceKm.toFixed(1)} km away</small>
+                        </li>
+                    ))}</ul>
+                ) : <p>No approved stories within 2 km in this category yet.</p>}
+                <Link to="/upload">Share a community story</Link>
+            </section>
+        </article>
+    );
+}
diff --git a/frontend/src/components/PlaceNameLayer.js b/frontend/src/components/PlaceNameLayer.js
new file mode 100644
--- /dev/null
+++ b/frontend/src/components/PlaceNameLayer.js
@@ -0,0 +1,32 @@
+import { useEffect } from "react";
+import L from "leaflet";
+import { Marker, Popup, useMap } from "react-leaflet";
+import PlaceNameCard from "./PlaceNameCard";
+
+const placeNameIcon = L.divIcon({
+    className: "place-name-marker",
+    html: '<span aria-hidden="true">Aa</span>',
+    iconSize: [38, 38],
+    iconAnchor: [19, 19],
+    popupAnchor: [0, -18],
+});
+
+export default function PlaceNameLayer({ places, focusPlace, stories, storiesLoading, storiesError }) {
+    const map = useMap();
+    useEffect(() => {
+        if (focusPlace) {
+            const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches || false;
+            map.flyTo([focusPlace.latitude, focusPlace.longitude], 12, { duration: 0.6, animate: !reducedMotion });
+        }
+    }, [map, focusPlace]);
+
+    return places.map((place) => (
+        <Marker key={place.id} position={[place.latitude, place.longitude]}
+            icon={placeNameIcon} title={place.displayName} alt={place.displayName}>
+            <Popup className="place-name-popup" autoPanPadding={[20, 20]}>
+                <PlaceNameCard place={place} stories={stories}
+                    storiesLoading={storiesLoading} storiesError={storiesError} />
+            </Popup>
+        </Marker>
+    ));
+}
