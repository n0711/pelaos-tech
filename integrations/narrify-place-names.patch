+import { render, screen, fireEvent } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import API from "../services/Api";
+import MapView from "./MapView";
+
+const mockMap = { flyTo: jest.fn() };
+jest.mock("react-leaflet", () => ({
+    MapContainer: ({ children }) => <div>{children}</div>,
+    Marker: ({ children }) => <div>{children}</div>,
+    Popup: ({ children }) => <div>{children}</div>,
+    TileLayer: () => null,
+    ZoomControl: () => null,
+    useMap: () => mockMap,
+}));
+jest.mock("leaflet", () => ({ divIcon: () => ({}) }));
+jest.mock("../services/Api", () => ({
+    __esModule: true, default: { get: jest.fn() }, mediaUrl: () => null,
+}));
+
+beforeEach(() => {
+    jest.clearAllMocks();
+    API.get.mockResolvedValue({ data: [{ id: 1, title: "Community memory", content: "Local history",
+        category: "heritage", status: "approved", latitude: 35.17284, longitude: 33.35397 }] });
+});
+
+test("switches layers, searches Greek names, resets filters and restores stories", async () => {
+    render(<MemoryRouter><MapView activeCategory="all" /></MemoryRouter>);
+    await screen.findByRole("heading", { name: "Community memory" });
+    fireEvent.click(screen.getByRole("button", { name: "Place names" }));
+    expect(screen.getByText(/3 place names/)).toBeTruthy();
+    fireEvent.change(screen.getByRole("searchbox", { name: "Search place names" }),
+        { target: { value: "ανωγυρα" } });
+    expect(screen.getByRole("heading", { name: "Anogyra" })).toBeTruthy();
+    expect(screen.queryByRole("heading", { name: "Lazanias" })).toBeNull();
+    fireEvent.change(screen.getByLabelText("Origins"), { target: { value: "reported" } });
+    expect(screen.getByText("No place names match")).toBeTruthy();
+    fireEvent.click(screen.getByRole("button", { name: "Reset place-name filters" }));
+    expect(screen.getByText(/3 place names/)).toBeTruthy();
+    fireEvent.click(screen.getByRole("button", { name: "Stories" }));
+    expect(screen.getByRole("heading", { name: "Community memory" })).toBeTruthy();
+    expect(API.get).toHaveBeenCalledTimes(1);
+});
+
+test("place-name records remain usable when the story API is unavailable", async () => {
+    API.get.mockRejectedValueOnce(new Error("offline"));
+    render(<MemoryRouter><MapView activeCategory="all" /></MemoryRouter>);
+    await screen.findByText(/We couldn't load the stories/);
+    fireEvent.click(screen.getByRole("button", { name: "Place names" }));
+    expect(screen.getByRole("heading", { name: "Anogyra" })).toBeTruthy();
+    expect(screen.getAllByText("Nearby stories are temporarily unavailable.")).toHaveLength(3);
+});
