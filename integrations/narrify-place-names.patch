@@ -0,0 +1,74 @@
+import catalog from "../data/placeNames.json";
+import {
+    PLACE_NAMES, filterPlaceNames, getOriginStatus, isSourceUrl,
+    nearbyApprovedStories, publishedPlaces, validatePlace,
+} from "./placeNames";
+
+const nicosia = catalog.places.find((place) => place.id === "nicosia");
+const localStory = { id: 7, title: "A local memory", status: "approved",
+    latitude: nicosia.latitude, longitude: nicosia.longitude };
+
+test("every committed pilot record is valid, public and uniquely identified", () => {
+    expect(catalog.schemaVersion).toBe(1);
+    expect(catalog.places.every(validatePlace)).toBe(true);
+    expect(PLACE_NAMES).toHaveLength(catalog.places.length);
+});
+
+test.each([
+    ["ανωγυρα", "anogyra"], ["ΑΝΏΓΥΡΑ", "anogyra"],
+    ["LEFKOSA", "nicosia"], ["Ledra", "nicosia"], ["ΛΑΖΑΝΙΑΣ", "lazanias"],
+])("searches current and historical forms: %s", (query, id) => {
+    expect(filterPlaceNames(PLACE_NAMES, query).map((place) => place.id)).toEqual([id]);
+});
+
+test("historical forms do not imply an origin; alternatives remain separate", () => {
+    expect(getOriginStatus(nicosia)).toBe("unresolved");
+    expect(filterPlaceNames(PLACE_NAMES, "", "unresolved").map((place) => place.id)).toEqual(["nicosia"]);
+    const [anogyra] = filterPlaceNames(PLACE_NAMES, "", "proposed");
+    expect(anogyra.id).toBe("anogyra");
+    expect(anogyra.claims.filter((claim) => claim.kind === "etymology")).toHaveLength(2);
+    expect(filterPlaceNames(PLACE_NAMES, "", "reported").map((place) => place.id)).toEqual(["lazanias"]);
+});
+
+test("disagreement remains distinct from possible explanations", () => {
+    const disputed = {...nicosia, claims: [{...nicosia.claims[0], kind: "etymology", status: "disputed"}]};
+    expect(getOriginStatus(disputed)).toBe("disputed");
+    expect(filterPlaceNames([disputed], "", "reported")).toEqual([]);
+});
+
+test("requires valid documentary sources for explanations, variants and coordinates", () => {
+    expect(validatePlace({...nicosia, claims: [{...nicosia.claims[0], sourceIds: []}]})).toBe(false);
+    expect(validatePlace({...nicosia, claims: [{...nicosia.claims[0], sourceIds: ["missing"]}]})).toBe(false);
+    expect(validatePlace({...nicosia, aliases: [{...nicosia.aliases[0], sourceId: "missing"}]})).toBe(false);
+    expect(validatePlace({...nicosia, locationSourceId: "missing"})).toBe(false);
+    expect(validatePlace({...nicosia, latitude: null})).toBe(false);
+});
+
+test.each(["javascript:alert(1)", "https://user:pass@example.com/", "https://./",
+    "http://example.com/", "https://example.com/ a", "https://example.com/\\evil"])(
+    "rejects unsafe or malformed source links: %s", (url) => {
+        expect(isSourceUrl(url)).toBe(false);
+        expect(validatePlace({...nicosia, sources: nicosia.sources.map((source) => ({...source, url}))})).toBe(false);
+    }
+);
+
+test("hides drafts, duplicate IDs and invalid records", () => {
+    expect(publishedPlaces([null, {...nicosia, editorialStatus: "draft"}, nicosia, nicosia])).toEqual([nicosia]);
+});
+
+test("nearby results require approval and valid coordinates", () => {
+    const records = [
+        localStory, {...localStory, id: 8, status: "rejected"},
+        {...localStory, id: 9, status: "pending"}, {...localStory, id: 10, latitude: null},
+        {...localStory, id: 11, longitude: " "}, {...localStory, id: 12, latitude: 181},
+        {...localStory, id: 13, latitude: nicosia.latitude + 1},
+    ];
+    expect(nearbyApprovedStories(nicosia, records).map(({story}) => story.id)).toEqual([7]);
+});
+
+test("caps nearby results, sorts equal distances consistently and preserves input", () => {
+    const records = [4,3,2,1].map((id) => ({...localStory, id}));
+    const before = JSON.stringify(records);
+    expect(nearbyApprovedStories(nicosia, records).map(({story}) => story.id)).toEqual([1,2,3]);
+    expect(JSON.stringify(records)).toBe(before);
+});
