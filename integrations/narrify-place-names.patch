+import { render, screen } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import PlaceNameCard from "./PlaceNameCard";
+import { PLACE_NAMES } from "../utils/placeNames";
+
+const renderCard = (id, props = {}) => render(
+    <MemoryRouter><PlaceNameCard place={PLACE_NAMES.find((place) => place.id === id)} {...props} /></MemoryRouter>
+);
+
+test("shows both Anogyra explanations with their individual sources", () => {
+    renderCard("anogyra");
+    expect(screen.getByText(/local anagyris plant/)).toBeTruthy();
+    expect(screen.getByText(/Another explanation combines/)).toBeTruthy();
+    expect(screen.getAllByText("Possible explanation")).toHaveLength(2);
+    const sources = screen.getAllByRole("link", { name: "Cyprus Deputy Ministry of Tourism" });
+    expect(sources).toHaveLength(2);
+    expect(sources[0].getAttribute("href")).toContain("anogyra-village-2");
+    expect(screen.getByRole("link", { name: "Source for Ανώγυρα" }).getAttribute("href")).toContain("geonames.org");
+});
+
+test("keeps historical forms distinct from missing etymology", () => {
+    renderCard("nicosia");
+    expect(screen.getByText("Ledra")).toBeTruthy();
+    expect(screen.getByText("No origin explanation has been added to this record.")).toBeTruthy();
+    expect(screen.getByText(/not a historical boundary/)).toBeTruthy();
+});
+
+test("shows API failure separately from a genuine empty result", () => {
+    renderCard("lazanias", { storiesError: "offline" });
+    expect(screen.getByText("Nearby stories are temporarily unavailable.")).toBeTruthy();
+    expect(screen.queryByText(/No approved stories within/)).toBeNull();
+});
