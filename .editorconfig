# Shared whitespace defaults for the Rust generator, Python audits, and Dart UI.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,py}]
indent_style = space
indent_size = 4

[*.{dart,json,yml,yaml,html,css}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
